# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/booleanmaths

# ---- Seed data ----
# Your 5 real hooks.slack.com URLs from Section 3 of the brief, comma-separated, no spaces needed.
SEED_SLACK_WEBHOOK_URLS=https://hooks.slack.com/services/T000/B000/xxx1,https://hooks.slack.com/services/T000/B000/xxx2,https://hooks.slack.com/services/T000/B000/xxx3,https://hooks.slack.com/services/T000/B000/xxx4,https://hooks.slack.com/services/T000/B000/xxx5

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Slack ----
# Point at the local mock endpoint while developing/testing the 429 path.
# Unset (or comment out) this line for the real run/demo so the worker posts
# to each client's own slack_webhook_url instead.
SLACK_ENDPOINT_OVERRIDE=http://localhost:4000/api/mock-slack-webhook

# ---- Scheduler ----
REPORT_TIMEZONE=Asia/Kolkata

# ---- Client (Vite) ----
VITE_API_BASE_URL=http://localhost:4000
